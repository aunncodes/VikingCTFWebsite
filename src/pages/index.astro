---
import '../styles/global.css';

const rsvpUrl = 'https://luma.com/';
const sponsorEmail = 'ihscyberclub0@gmail.com';
const sponsorMailto = `mailto:${sponsorEmail}?subject=${encodeURIComponent('VikingCTF sponsorship')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="VikingCTF is a free, in-person, one-day high school cybersecurity competition in January 2027." />
    <meta name="theme-color" content="#173a8a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>VikingCTF</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <header class="site-header">
      <div class="header shell">
        <a class="brand" href="#top">VikingCTF</a>
        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#format">Format</a>
          <a href="#sponsor">Sponsor</a>
          <a href="#faq">FAQ</a>
          <a class="pill" href={rsvpUrl} target="_blank" rel="noreferrer">RSVP</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero-zone">
        <div class="hero-stars" aria-hidden="true">
          <span class="star star-a">✦</span>
          <span class="star star-b">✦</span>
          <span class="star star-c">✦</span>
          <span class="star star-d">✦</span>
        </div>

        <div class="hero shell">
          <div class="hero-copy">
            <p class="hero-note">Irvington High School Cybersecurity Club presents</p>
            <h1>VikingCTF</h1>
            <p class="hero-lede">
              A free, in-person, one-day jeopardy-style cybersecurity competition for high school students across the Bay Area.
            </p>
            <div class="hero-actions">
              <a class="button button-light" href={rsvpUrl} target="_blank" rel="noreferrer">
                RSVP on Luma
                <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 14 14 4M7 4h7v7" /></svg>
              </a>
              <a class="text-link" href="#about">Learn more <span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <div class="countdown-wrap" aria-label="Countdown to January 9, 2027">
            <div class="orbit orbit-one" aria-hidden="true"></div>
            <div class="orbit orbit-two" aria-hidden="true"></div>
            <span class="float-tag float-tag-a" aria-hidden="true">FLAG</span>
            <span class="float-tag float-tag-b" aria-hidden="true">PWN</span>
            <span class="float-tag float-tag-c" aria-hidden="true">WEB</span>
            <span class="float-tag float-tag-d" aria-hidden="true">CRYPTO</span>
            <div class="countdown-card">
              <div class="countdown-tape">JAN 09 · 2027</div>
              <span id="countdown" class="countdown-number">000</span>
              <span class="countdown-label">days until VikingCTF</span>
              <span id="countdown-readable" class="sr-only"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="facts" aria-label="Event details">
        <div class="facts-grid shell">
          <div><small>Date</small><strong>January 9, 2027</strong></div>
          <div><small>Location</small><strong>Bay Area · Venue TBA</strong></div>
          <div><small>Cost</small><strong>Free to attend</strong></div>
          <div><small>Who</small><strong>High school students</strong></div>
        </div>
      </section>

      <section id="about" class="about shell">
        <div class="about-title" data-reveal>
          <h2>What VikingCTF is.</h2>
        </div>
        <div class="about-copy" data-reveal>
          <p>
            VikingCTF is a one-day, in-person cybersecurity competition run by Irvington High School's Cybersecurity Club. Students solve standalone challenges, recover hidden flags, and compete for points throughout the event.
          </p>
          <p>
            The goal is to make the event genuinely approachable for beginners while still being interesting for students who already have CTF experience.
          </p>
          <a class="inline-cta" href={rsvpUrl} target="_blank" rel="noreferrer">Register on Luma <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="format" class="format">
        <div class="format-shell shell">
          <div class="format-intro" data-reveal>
            <div>
              <h2>What to expect.</h2>
            </div>
            <p>
              VikingCTF uses a jeopardy-style format, which means you choose from a board of separate challenges instead of working through one long problem set.
            </p>
          </div>

          <div class="format-content" data-reveal>
            <ul class="format-list">
              <li>Pick a challenge from the board and work through its files, prompts, or hosted service.</li>
              <li>Find the hidden flag inside the challenge.</li>
              <li>Submit the flag on the event platform to earn points.</li>
              <li>Start with easier problems if you are new. Harder challenges will be there too.</li>
            </ul>

          </div>

          <div class="beginner-note" data-reveal>
            <strong>Beginner-friendly.</strong>
            <p>
              You do not need prior CTF experience to attend. We want first-time competitors to have a clear way in, not just watch more experienced people play.
            </p>
          </div>
        </div>
      </section>

      <section id="sponsor" class="sponsor">
        <div class="sponsor-inner shell">
          <div class="sponsor-copy" data-reveal>
            <h2>Help keep VikingCTF free.</h2>
            <p>
              Sponsorship helps cover food, prizes, and venue costs. It also gives supporting organizations a direct way to meet students who are actively learning cybersecurity.
            </p>
            <div class="sponsor-actions">
              <a class="button button-blue" href={sponsorMailto}>Contact us about sponsoring</a>
              <a class="prospectus-link" href="/VikingCTF-Sponsorship-Prospectus.pdf" target="_blank" rel="noreferrer">View sponsorship prospectus <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="tiers" data-reveal aria-label="Sponsorship tiers">
            <div class="tier"><span>Title sponsor</span><strong>$1,500</strong></div>
            <div class="tier"><span>Gold</span><strong>$1,000</strong></div>
            <div class="tier"><span>Silver</span><strong>$500</strong></div>
            <div class="tier"><span>Bronze</span><strong>$250</strong></div>
            <div class="tier tier-inkind"><span>In-kind</span><strong>Based on value</strong></div>
          </div>
        </div>
      </section>

      <section id="faq" class="faq">
        <div class="faq-inner shell">
          <div class="faq-heading" data-reveal>
            <h2>FAQ</h2>
          </div>
          <div class="faq-list" data-reveal>
            <details open>
              <summary>When is VikingCTF?</summary>
              <p>We are currently planning for January 9, 2027. The full event schedule will be posted once the remaining logistics are finalized.</p>
            </details>
            <details>
              <summary>Where is the event?</summary>
              <p>VikingCTF will be held in person in the Bay Area. The specific venue has not been announced yet.</p>
            </details>
            <details>
              <summary>Who can attend?</summary>
              <p>The event is for high school students, including students who have never competed in a CTF before.</p>
            </details>
            <details>
              <summary>How much does it cost?</summary>
              <p>Nothing. VikingCTF is free for attendees.</p>
            </details>
            <details>
              <summary>What challenge categories will there be?</summary>
              <p>The final challenge set is still being built, so we are not publishing a fixed category list yet.</p>
            </details>
            <details>
              <summary>Can my company sponsor VikingCTF?</summary>
              <p>Yes. Sponsorship packages range from Bronze through Title Sponsor, and in-kind contributions are also welcome.</p>
            </details>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer shell">
      <div>
        <strong>VikingCTF</strong>
        <p>January 2027 · Bay Area</p>
      </div>
      <a href={`mailto:${sponsorEmail}`}>{sponsorEmail}</a>
    </footer>

    <script>
      import { animate, inView, stagger } from 'motion';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countdown = document.querySelector('#countdown');
      const countdownReadable = document.querySelector('#countdown-readable');
      const siteHeader = document.querySelector('.site-header');

      const updateHeader = () => siteHeader?.classList.toggle('is-scrolled', window.scrollY > 18);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const now = new Date();
      const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
      const daysLeft = Math.max(0, Math.ceil((Date.UTC(2027, 0, 9) - today) / 86_400_000));

      if (countdownReadable) countdownReadable.textContent = `${daysLeft} days until VikingCTF`;

      if (countdown) {
        if (reducedMotion) {
          countdown.textContent = String(daysLeft);
        } else {
          animate(999, daysLeft, {
            duration: 1.55,
            ease: [0.16, 1, 0.3, 1],
            onUpdate: (value) => countdown.textContent = String(Math.round(value)),
            onComplete: () => animate(countdown, { scale: [1, 1.06, 1] }, { duration: 0.3 })
          });
        }
      }

      if (!reducedMotion) {
        animate('.hero-copy > *', { opacity: [0, 1], y: [30, 0] }, {
          duration: 0.72,
          delay: stagger(0.09),
          ease: [0.16, 1, 0.3, 1]
        });

        animate('.countdown-wrap', { opacity: [0, 1], scale: [0.94, 1], rotate: [1.5, 0] }, {
          duration: 0.85,
          delay: 0.12,
          ease: [0.16, 1, 0.3, 1]
        });

        animate('.float-tag', { y: [0, -8, 0] }, {
          duration: 3.8,
          repeat: Infinity,
          direction: 'alternate',
          ease: 'easeInOut',
          delay: stagger(0.15)
        });

        animate('.star', { opacity: [0.45, 1, 0.45], scale: [1, 1.15, 1] }, {
          duration: 3.2,
          repeat: Infinity,
          direction: 'alternate',
          ease: 'easeInOut',
          delay: stagger(0.2)
        });

        inView('[data-reveal]', (element) => {
          animate(element, { opacity: [0, 1], y: [28, 0] }, {
            duration: 0.68,
            ease: [0.16, 1, 0.3, 1]
          });
        }, { amount: 0.15 });
      }
    </script>
  </body>
</html>
